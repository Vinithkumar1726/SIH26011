# SIH26011 - Environment Configuration
# Copy this file to .env and update the values

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/sih26011
DATABASE_URL_SYNC=postgresql://postgres:YOUR_PASSWORD@localhost:5432/sih26011

# Frontend API Configuration
VITE_API_URL=http://127.0.0.1:8000

# Backend CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: Cesium Ion Token (for terrain/imagery)
# CESIUM_ION_TOKEN=your_token_here

